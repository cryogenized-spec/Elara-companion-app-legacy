{
  "name": "elara-companion-v3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lockbox:validate": "node scripts/lockbox-validate.mjs",
    "lockbox:audit": "node scripts/lockbox-audit.mjs",
    "lockbox:secrets": "node scripts/lockbox-secret-scan.mjs",
    "lockbox:status": "node scripts/lockbox-status.mjs",
    "lockbox:verify": "node scripts/lockbox-verify.mjs",
    "lint": "npm run lockbox:validate && npm run lockbox:audit && npm run lockbox:secrets && tsc --noEmit && npm --prefix background-runtime install --no-audit --no-fund && npm --prefix background-runtime run typecheck",
    "test": "node --import tsx --test",
    "benchmark:memory": "tsx scripts/benchmark-memory-consolidation.ts",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "diff": "^9.0.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.16.1",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
